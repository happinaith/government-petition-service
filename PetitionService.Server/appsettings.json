{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=petitions.db"
  },
  "Auth": {
    "AdminBootstrapToken": "CHANGE_ME_BOOTSTRAP_TOKEN"
  },
  "Gemini": {
    "ApiBaseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "Model": "gemini-1.5-flash",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "MaxRetries": 2
  },
  "ObjectStorage": {
    "Provider": "Minio",
    "RootPath": "object-storage",
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [
      "application/pdf",
      "image/png",
      "image/jpeg",
      "text/plain"
    ],
    "PreSignedUrlTtlMinutes": 5,
    "Minio": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "Bucket": "petition-attachments",
      "ForcePathStyle": true
    }
  },
  "Jwt": {
    "Issuer": "petition.local",
    "Audience": "petition.local",
    "Key": "DEV_KEY_CHANGE_ME_123456789_ABCDEF_123456789",
    "AccessTokenTtlMinutes": 15,
    "RefreshTokenTtlDays": 7
  }
}
