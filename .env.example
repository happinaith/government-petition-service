## Example environment variables for local development
# Copy this file to `.env` and fill secrets (do NOT commit `.env`).

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Connection string for SQLite inside container (do not put a production DB here)
CONNECTIONSTRINGS__DEFAULT=Data Source=/data/petitions.db

# Object storage provider (Minio or Local)
OBJECTSTORAGE__PROVIDER=Minio

# JWT signing key (replace in production)
JWT__Key=DEV_KEY_CHANGE_ME_123456789_ABCDEF

# Gemini API key placeholder (do NOT commit real keys)
GEMINI__ApiKey=CHANGE_ME_GEMINI_API_KEY
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# CI/CD secrets (set these in GitHub Actions repository secrets, do NOT add to .env)
# DOCKER_REGISTRY - registry host (e.g. ghcr.io or docker.io)
# DOCKER_USERNAME - registry user
# DOCKER_PASSWORD - registry password or token
# DEPLOY_SSH_PRIVATE_KEY - private key for SSH deployment
# DEPLOY_USER - remote SSH user
# DEPLOY_HOST - remote host or IP
# DEPLOY_PATH - path to the repository on the remote host
